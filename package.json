{
  "name": "luxbound",
  "version": "0.1.0",
  "description": "LuxDevHQ Progress & Support \u2014 student accountability portal",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "rules": "node --env-file-if-exists=.env scripts/run-rules.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "mail:test": "node --env-file-if-exists=.env scripts/mail-test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0"
  }
}
